{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Project-supported EKS Auto Mode IngressClassParams fields. Extend deliberately when using more of https://docs.aws.amazon.com/eks/latest/userguide/auto-configure-alb.html",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {"const": "eks.amazonaws.com/v1"},
    "kind": {"const": "IngressClassParams"},
    "metadata": {"type": "object", "required": ["name"]},
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scheme": {"enum": ["internet-facing", "internal"]},
        "targetType": {"enum": ["ip", "instance"]},
        "ipAddressType": {"enum": ["ipv4", "dualstack"]},
        "group": {"type": "object", "required": ["name"], "additionalProperties": false, "properties": {"name": {"type": "string", "minLength": 1}}},
        "certificateARNs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^arn:aws:acm:"}},
        "sslPolicy": {"type": "string", "minLength": 1},
        "inboundCIDRs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "namespaceSelector": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "matchLabels": {"type": "object", "additionalProperties": {"type": "string"}},
            "matchExpressions": {"type": "array", "items": {"type": "object", "required": ["key", "operator"], "additionalProperties": false, "properties": {"key": {"type": "string"}, "operator": {"enum": ["In", "NotIn", "Exists", "DoesNotExist"]}, "values": {"type": "array", "items": {"type": "string"}}}}}
          }
        },
        "listeners": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["port", "protocol"], "additionalProperties": false, "properties": {"port": {"type": "integer", "minimum": 1, "maximum": 65535}, "protocol": {"enum": ["HTTP", "HTTPS"]}}}}
      }
    }
  }
}
