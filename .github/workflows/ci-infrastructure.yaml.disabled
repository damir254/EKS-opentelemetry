name: Infrastructure CI

on:
  pull_request:
    paths:
      - "terraform/**"
      - "helm/**"
      - "platform/**"
      - ".github/workflows/**"
      - ".github/scripts/**"
  push:
    branches: [main]
    paths:
      - "terraform/**"
      - "helm/**"
      - "platform/**"
      - ".github/workflows/**"
      - ".github/scripts/**"

permissions:
  contents: read

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  terraform:
    runs-on: ubuntu-24.04
    timeout-minutes: 15
    env:
      TF_IN_AUTOMATION: "true"
      AWS_EC2_METADATA_DISABLED: "true"
    steps:
      - name: Check out repository
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      - name: Set up Terraform
        uses: hashicorp/setup-terraform@dfe3c3f87815947d99a8997f908cb6525fc44e9e # v4.0.1
        with:
          terraform_version: 1.16.2
          terraform_wrapper: false

      - name: Check Terraform formatting
        run: terraform fmt -check -recursive terraform

      - name: Validate main configuration without AWS or a backend
        run: |
          terraform -chdir=terraform init -backend=false -input=false -lockfile=readonly
          terraform -chdir=terraform validate

      - name: Validate standalone bootstrap
        run: |
          terraform -chdir=terraform/bootstrap init -backend=false -input=false -lockfile=readonly
          terraform -chdir=terraform/bootstrap validate

  helm-and-workflows:
    runs-on: ubuntu-24.04
    timeout-minutes: 15
    steps:
      - name: Check out repository
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      - name: Set up Helm
        uses: azure/setup-helm@9bc31f4ebc9c6b171d7bfbaa5d006ae7abdb4310 # v5.0.1
        with:
          version: v4.2.3

      - name: Set up Python for YAML validation
        uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7.0.0
        with:
          python-version: "3.13"
        

      - name: Install YAML parser
        run: python -m pip install -r .github/scripts/requirements.txt

      - name: Install checksum-pinned actionlint and kubeconform
        working-directory: ${{ runner.temp }}
        run: |
          curl --fail --silent --show-error --location --retry 3 --output actionlint.tar.gz https://github.com/rhysd/actionlint/releases/download/v1.7.12/actionlint_1.7.12_linux_amd64.tar.gz
          echo '8aca8db96f1b94770f1b0d72b6dddcb1ebb8123cb3712530b08cc387b349a3d8  actionlint.tar.gz' | sha256sum --check
          curl --fail --silent --show-error --location --retry 3 --output kubeconform.tar.gz https://github.com/yannh/kubeconform/releases/download/v0.8.0/kubeconform-linux-amd64.tar.gz
          echo '9bc2bffbf71f261128533edaf912153948b7ff238f9a531ae6d34466ec287883  kubeconform.tar.gz' | sha256sum --check
          mkdir -p ci-tools
          tar -xzf actionlint.tar.gz -C ci-tools actionlint
          tar -xzf kubeconform.tar.gz -C ci-tools kubeconform
          echo "$PWD/ci-tools" >> "$GITHUB_PATH"

      - name: Lint GitHub Actions workflows
        run: actionlint .github/workflows/*.yaml

      - name: Lint, render, and schema-check Helm and platform YAML
        run: bash .github/scripts/validate-kubernetes.sh
