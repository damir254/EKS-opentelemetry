{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "region": {
      "type": "string",
      "pattern": "^[a-z]{2}-[a-z]+-[0-9]$"
    },
    "cidrGroups": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "alb": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/([0-9]|[12][0-9]|3[0-2])$"
          }
        },
        "private": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/([0-9]|[12][0-9]|3[0-2])$"
          }
        },
        "api": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/([0-9]|[12][0-9]|3[0-2])$"
          }
        },
        "podIdentity": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/([0-9]|[12][0-9]|3[0-2])$"
          }
        },
        "dns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/([0-9]|[12][0-9]|3[0-2])$"
          }
        }
      },
      "required": [
        "alb",
        "private",
        "api",
        "podIdentity",
        "dns"
      ]
    },
    "externalProfiles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "domains": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "ports": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "required": [
          "domains",
          "ports"
        ]
      }
    },
    "workloads": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "namespace": {
            "enum": [
              "argocd",
              "monitoring",
              "external-secrets",
              "external-dns",
              "argo-rollouts",
              "istio-system",
              "identity",
              "kube-system",
              "dev"
            ]
          },
          "selector": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string"
            }
          },
          "ingressCIDRs": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            },
            "propertyNames": {
              "enum": [
                "alb",
                "private",
                "api",
                "podIdentity",
                "dns"
              ]
            }
          },
          "egressCIDRs": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            },
            "propertyNames": {
              "enum": [
                "alb",
                "private",
                "api",
                "podIdentity",
                "dns"
              ]
            }
          },
          "externalProfiles": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "identity",
                "gitHelm",
                "gitSSH",
                "ecr",
                "secrets",
                "databaseBootstrap",
                "dns"
              ]
            }
          },
          "api": {
            "type": "boolean"
          },
          "podIdentity": {
            "type": "boolean"
          },
          "managed": {
            "type": "boolean"
          },
          "services": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
            },
            "additionalProperties": {
              "type": "object",
              "patternProperties": {
                "^[0-9]+$": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  }
                }
              },
              "additionalProperties": false,
              "minProperties": 1
            }
          }
        },
        "required": [
          "namespace",
          "selector"
        ]
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "ports": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          },
          "protocol": {
            "enum": [
              "TCP",
              "UDP"
            ]
          }
        },
        "required": [
          "from",
          "to",
          "ports"
        ]
      }
    },
    "namespaces": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "enum": [
          "argocd",
          "monitoring",
          "external-secrets",
          "external-dns",
          "argo-rollouts",
          "istio-system",
          "identity",
          "dev"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "defaultDeny": {
            "type": "boolean"
          },
          "labels": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": [
          "defaultDeny"
        ]
      }
    }
  },
  "required": [
    "region",
    "cidrGroups",
    "externalProfiles",
    "workloads",
    "connections",
    "namespaces"
  ]
}
