{
  "realm": "platform",
  "enabled": true,
  "displayName": "Platform",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "sslRequired": "external",
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "passwordPolicy": "length(14) and notUsername and notEmail",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 28800,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA256",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "groups": [{"name": "platform-admins"}, {"name": "platform-viewers"}],
  "requiredActions": [{"alias": "CONFIGURE_TOTP", "name": "Configure OTP", "providerId": "CONFIGURE_TOTP", "enabled": true, "defaultAction": true, "priority": 10}],
  "clients": [
    {
      "clientId": "argocd",
      "name": "Argo CD",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": true,
      "fullScopeAllowed": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["https://argocd.damircloud.com/auth/callback", "https://argocd.damircloud.com/pkce/verify", "http://localhost:8085/auth/callback"],
      "webOrigins": ["https://argocd.damircloud.com"],
      "attributes": {"pkce.code.challenge.method": "S256", "post.logout.redirect.uris": "https://argocd.damircloud.com/applications"},
      "defaultClientScopes": ["profile", "email", "groups"],
      "optionalClientScopes": []
    },
    {
      "clientId": "grafana",
      "name": "Grafana",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": false,
      "fullScopeAllowed": false,
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["https://grafana.damircloud.com/login/generic_oauth"],
      "webOrigins": ["https://grafana.damircloud.com"],
      "attributes": {"pkce.code.challenge.method": "S256", "post.logout.redirect.uris": "https://grafana.damircloud.com/login"},
      "defaultClientScopes": ["profile", "email", "groups"],
      "optionalClientScopes": []
    }
  ]
}
